---
/**
 * ShortcutsDialog.astro — the homepage Shortcuts modal.
 *
 * Renders the <dialog> ONLY. The trigger button lives in index.astro beside
 * its sibling pills, because `.router-pill` is scoped to that page's Astro
 * hash — a button rendered from this component would not match the selector
 * and would fall back to the raw UA button styling.
 *
 * Any element with [data-shortcuts-open] opens it; the wiring below binds
 * document-wide, so the trigger's location does not matter.
 *
 * The pill is a BUTTON, not a link: it navigates nowhere and opens a modal
 * listing every shortcut instead (DECISIONS 2026-09-15 evening). Rationale:
 * the question "what keys are there?" is answered in two seconds by a list;
 * sending someone to a page to read it costs a navigation each way and a
 * lost place on the homepage.
 *
 * Native <dialog> + showModal() deliberately — it gives ESC-to-close, focus
 * trapping, inertness of the page behind, and a ::backdrop for free. Only
 * the backdrop-click dismissal is hand-wired (the platform has no built-in).
 *
 * The same data powers the inline key-combo popovers (ShortcutKey.astro), so
 * a combo can never say one thing here and another in a tip.
 */
import { SHORTCUTS, SHORTCUT_GROUPS, splitKeys, keysFor } from '../data/shortcuts';

const grouped = SHORTCUT_GROUPS
  .map((g) => ({ ...g, items: SHORTCUTS.filter((s) => s.group === g.key) }))
  .filter((g) => g.items.length > 0);
---

<dialog class="scd" id="nbg-shortcuts-dialog" aria-labelledby="nbg-scd-title">
  <div class="scd__head">
    <div class="scd__headmain">
      <p class="scd__eyebrow">Keyboard</p>
      <div class="scd__titlerow">
        <h2 class="scd__title" id="nbg-scd-title">Shortcuts</h2>
        <!-- Reuses the site-wide OS contract: localStorage `nbgaihub.os-prefer`
             + `<html data-os-prefer>`, the same one the use-case pages use, so
             a reader picks their OS once and it sticks everywhere. -->
        <div class="scd__os os-toggle" role="tablist" aria-label="Choose your operating system">
    <button type="button" class="os-toggle__btn scd__os-btn" data-os-choice="mac" role="tab" aria-selected="true">
      <svg class="scd__os-glyph" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M16.6 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.9-3-.8-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .8 1.1 1.7 2.3 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.2.9-1.3 1.3-2.5 1.3-2.6-.1 0-2.5-1-2.5-3.6zM14.3 5.4c.6-.8 1.1-1.9 1-3-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.2-.6 2.9-1.4z"/></svg> macOS
    </button>
    <button type="button" class="os-toggle__btn scd__os-btn" data-os-choice="windows" role="tab" aria-selected="false">
      <svg class="scd__os-glyph" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M3 5.6l7.6-1v7.1H3V5.6zm0 12.8l7.6 1v-7H3v6zm8.5 1.1L21 21V13h-9.5v6.5zM11.5 4v7.7H21V3l-9.5 1z"/></svg> Windows
          </button>
        </div>
      </div>
    </div>
    <button type="button" class="scd__close" data-shortcuts-close aria-label="Close">&times;</button>
  </div>

  <p class="scd__lede">
    Everyone learns <kbd class="scd__cap">Esc</kbd>. These are the rest — all checked
    against Claude Code itself, not copied off a blog.
  </p>

  <div class="scd__body">
    {grouped.map((g) => (
      <section class="scd__group">
        <h3 class="scd__group-title">{g.label}</h3>
        <p class="scd__group-blurb">{g.blurb}</p>
        <ul class="scd__list" role="list">
          {g.items.map((s) => (
            <li class="scd__row">
              <span class="scd__keys">
                {(['mac', 'windows'] as const).map((os) => {
                  const combo = splitKeys(keysFor(s, os));
                  return (
                    <span class="scd__combo" data-os={os}>
                      {combo.parts.map((part, i) => (
                        <>
                          {i > 0 && <span class="scd__join">{combo.joiner === '+' ? '+' : 'then'}</span>}
                          <kbd class="scd__cap">{part}</kbd>
                        </>
                      ))}
                    </span>
                  );
                })}
              </span>
              <div class="scd__text">
                <span class="scd__does">{s.does}</span>
                <span class="scd__when">{s.when}</span>
                {s.note && <span class="scd__osnote scd__osnote--any">{s.note}</span>}
                {s.noteMac && <span class="scd__osnote" data-os="mac">{s.noteMac}</span>}
                {s.noteWin && <span class="scd__osnote" data-os="windows">{s.noteWin}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <p class="scd__foot">
    The keys are the same on both systems — only the modifier's name changes
    (macOS calls Alt <em>Option</em>). Run <code>/keybindings</code> in any session
    to see exactly what is bound on your machine.
  </p>
</dialog>

<script>
  // OS preference — same contract as the use-case pages: localStorage
  // `nbgaihub.os-prefer` + `<html data-os-prefer>`. First visit guesses from
  // the user agent so nobody has to touch the toggle to see the right keys.
  function initOsPreference(): void {
    const KEY = 'nbgaihub.os-prefer';
    const read = (): 'mac' | 'windows' => {
      try {
        const v = localStorage.getItem(KEY);
        if (v === 'mac' || v === 'windows') return v;
      } catch { /* storage blocked */ }
      const ua = navigator.userAgent;
      return /Mac|iPhone|iPad/i.test(ua) ? 'mac' : 'windows';
    };
    const apply = (v: 'mac' | 'windows') => {
      document.documentElement.setAttribute('data-os-prefer', v);
      document.querySelectorAll<HTMLElement>('.os-toggle__btn').forEach((b) => {
        b.setAttribute('aria-selected', b.dataset.osChoice === v ? 'true' : 'false');
      });
    };
    apply(read());
    document.querySelectorAll<HTMLElement>('.scd__os-btn').forEach((b) => {
      if (b.dataset.nbgOsWired === 'true') return;
      b.dataset.nbgOsWired = 'true';
      b.addEventListener('click', () => {
        const v = b.dataset.osChoice === 'windows' ? 'windows' : 'mac';
        try { localStorage.setItem(KEY, v); } catch { /* ignore */ }
        apply(v);
      });
    });
  }

  function wireShortcutsDialog(): void {
    const dlg = document.getElementById('nbg-shortcuts-dialog') as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.nbgWired === 'true') return;
    dlg.dataset.nbgWired = 'true';

    const open = () => {
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else dlg.setAttribute('open', ''); // no <dialog> support: still readable
    };
    const close = () => {
      if (typeof dlg.close === 'function') dlg.close();
      else dlg.removeAttribute('open');
    };

    document.querySelectorAll('[data-shortcuts-open]').forEach((b) =>
      b.addEventListener('click', open),
    );
    dlg.querySelectorAll('[data-shortcuts-close]').forEach((b) =>
      b.addEventListener('click', close),
    );

    // Click the backdrop to dismiss. The dialog's own box is the only child
    // that reports a hit, so anything outside its rect is backdrop.
    dlg.addEventListener('click', (e) => {
      const r = dlg.getBoundingClientRect();
      const ev = e as MouseEvent;
      const inside =
        ev.clientX >= r.left && ev.clientX <= r.right &&
        ev.clientY >= r.top && ev.clientY <= r.bottom;
      if (!inside) close();
    });
  }

  initOsPreference();
  wireShortcutsDialog();
  document.addEventListener('astro:page-load', () => {
    initOsPreference();
    wireShortcutsDialog();
  });
</script>

<style>
  /* !important on layout/typography per docs/reference/starlight-cascade-gotcha.md */
  .scd {
    /* The UA centres a modal <dialog> via `margin: auto`, but a global reset
       on this site zeroes element margins and wins, pinning it left. Restore
       it explicitly rather than hunting the offending rule. */
    margin: auto !important;
    width: min(46rem, calc(100vw - 2rem)) !important;
    max-height: min(80vh, 46rem) !important;
    padding: 0 !important;
    border: 1px solid var(--nbg-border) !important;
    border-radius: 14px !important;
    background: var(--nbg-surface) !important;
    color: var(--nbg-ink) !important;
    box-shadow: 0 32px 80px -24px rgb(0 0 0 / 45%) !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
  }
  .scd::backdrop { background: rgb(8 14 22 / 55%); backdrop-filter: blur(2px); }
  .scd:not([open]) { display: none !important; }

  .scd__head {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 1rem !important;
    padding: 1.15rem 1.35rem 0.5rem !important;
  }
  .scd__eyebrow {
    margin: 0 0 0.15rem !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace !important;
    font-size: 0.625rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: var(--nbg-accent) !important;
  }
  .scd__title {
    margin: 0 !important;
    font-size: 1.6rem !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
  }
  .scd__close {
    flex: none !important;
    width: 2rem !important; height: 2rem !important;
    display: grid !important; place-items: center !important;
    font-size: 1.4rem !important; line-height: 1 !important;
    border: 1px solid var(--nbg-border) !important;
    border-radius: 8px !important;
    background: var(--nbg-surface-2) !important;
    color: var(--nbg-muted) !important;
    cursor: pointer !important;
  }
  .scd__close:hover { color: var(--nbg-ink) !important; border-color: var(--nbg-accent) !important; }

  /* Segmented OS switch. `:global` on the visibility rules because
     `data-os-prefer` lives on <html>, outside this component's scope. */
  .scd__headmain { min-width: 0 !important; }
  /* Toggle rides alongside the title rather than occupying its own band —
     it is a small qualifier on the heading, not a section of its own. */
  .scd__titlerow {
    display: flex !important;
    align-items: center !important;
    gap: 0.85rem !important;
    flex-wrap: wrap !important;
  }
  .scd__os {
    display: inline-flex !important;
    gap: 0.1rem !important;
    margin: 0 !important;
    padding: 0.13rem !important;
    border-radius: 999px !important;
    background: var(--nbg-surface-2) !important;
    border: 1px solid var(--nbg-border) !important;
  }
  .scd__os-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.28rem !important;
    padding: 0.17rem 0.5rem !important;
    border: 0 !important;
    border-radius: 999px !important;
    background: transparent !important;
    color: var(--nbg-muted) !important;
    font: inherit !important;
    font-size: 0.6875rem !important;
    font-weight: 500 !important;
    letter-spacing: 0.01em !important;
    cursor: pointer !important;
  }
  .scd__os-btn[aria-selected='true'] {
    background: var(--nbg-accent) !important;
    color: #fff !important;
    font-weight: 600 !important;
  }
  .scd__os-glyph {
    width: 0.85em !important;
    height: 0.85em !important;
    flex: none !important;
  }

  .scd__osnote--any { color: var(--nbg-muted) !important; }
  .scd__osnote {
    margin-top: 0.15rem !important;
    font-size: 0.75rem !important;
    color: var(--nbg-accent-ink) !important;
  }

  .scd__keys { justify-self: start !important; }

  .scd__lede {
    margin: 0 !important;
    padding: 0 1.35rem 0.9rem !important;
    font-size: 0.9rem !important;
    line-height: 1.55 !important;
    color: var(--nbg-muted) !important;
    border-bottom: 1px solid var(--nbg-border) !important;
  }

  .scd__body {
    overflow-y: auto !important;
    padding: 0.4rem 1.35rem 0.6rem !important;
    display: grid !important;
    gap: 1.15rem !important;
  }
  .scd__group { margin: 0 !important; }
  .scd__group-title {
    margin: 0.9rem 0 0.1rem !important;
    font-size: 0.95rem !important;
    font-weight: 600 !important;
  }
  .scd__group-blurb {
    margin: 0 0 0.55rem !important;
    font-size: 0.8125rem !important;
    color: var(--nbg-muted) !important;
  }
  .scd__list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    gap: 0.15rem !important;
  }
  /* Starlight/agentnews ship unlayered block margins that beat our layer.
     Measured: `.scd__text` was inheriting `margin: 16px 0 20px`, adding 36px
     to every row. Reset margins on the row and everything inside it — but NOT
     padding, which the row uses for its own hover target. */
  .scd__list > li { margin: 0 !important; }
  .scd__row > *, .scd__text > * { margin: 0 !important; }
  .scd__row {
    display: grid !important;
    grid-template-columns: 7.5rem 1fr !important;
    align-items: baseline !important;
    gap: 0.7rem !important;
    padding: 0.4rem 0.5rem !important;
    border-radius: 8px !important;
  }
  .scd__row:hover { background: var(--nbg-surface-2) !important; }
  /* One cap per physical key: [Ctrl] + [T] rather than one wide [Ctrl+T]
     chip, so the row shows what you actually press. */
  .scd__combo {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.22rem !important;
    white-space: nowrap !important;
  }
  .scd__cap {
    display: inline-block !important;
    min-width: 1.35rem !important;
    padding: 0.16rem 0.4rem !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace !important;
    font-size: 0.75rem !important;
    line-height: 1.3 !important;
    text-align: center !important;
    white-space: nowrap !important;
    background: var(--nbg-surface) !important;
    border: 1px solid var(--nbg-border) !important;
    border-bottom-width: 2px !important;
    border-radius: 5px !important;
    color: var(--nbg-ink) !important;
    box-shadow: 0 1px 0 rgb(13 27 42 / 4%) !important;
  }
  /* "+" = hold together, "then" = press in sequence. */
  .scd__join {
    margin: 0 0.1rem !important;
    font-size: 0.6875rem !important;
    color: var(--nbg-muted) !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace !important;
  }
  .scd__text {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.1rem !important;
    min-width: 0 !important;
    margin: 0 !important;
  }
  .scd__does { font-size: 0.9rem !important; font-weight: 500 !important; line-height: 1.35 !important; }
  .scd__when { font-size: 0.8125rem !important; color: var(--nbg-muted) !important; line-height: 1.45 !important; }

  .scd__foot {
    margin: 0 !important;
    padding: 0.7rem 1.35rem 0.95rem !important;
    border-top: 1px solid var(--nbg-border) !important;
    font-size: 0.8125rem !important;
    color: var(--nbg-muted) !important;
    background: var(--nbg-surface-2) !important;
  }

  @media (max-width: 34rem) {
    .scd__row { grid-template-columns: 1fr !important; gap: 0.2rem !important; }
  }
</style>

<style is:global>
  /* OS-conditional key spellings. Must be GLOBAL and unscoped: the driving
     attribute `data-os-prefer` lives on <html>, outside this component's
     scope hash, and the rule has to travel with the component rather than
     living in a stylesheet the homepage does not import. */
  [data-os-prefer='mac'] .scd__combo[data-os='windows'],
  [data-os-prefer='mac'] .scd__osnote[data-os='windows'],
  [data-os-prefer='windows'] .scd__combo[data-os='mac'],
  [data-os-prefer='windows'] .scd__osnote[data-os='mac'] {
    display: none !important;
  }
  /* No preference yet (JS blocked): show one spelling, not both. */
  html:not([data-os-prefer]) .scd__combo[data-os='windows'],
  html:not([data-os-prefer]) .scd__osnote[data-os='windows'] {
    display: none !important;
  }
</style>
