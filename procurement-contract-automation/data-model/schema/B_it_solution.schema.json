{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nbg.gr/procurement/contracts/B_it_solution.schema.json",
  "title": "Κατηγορία B — IT SOLUTION (Σύμβαση Παροχής Υπηρεσιών SaaS / Λύσης)",
  "description": "Πρότυπο NBG_IT Solution — 19 άρθρα, 3 παραρτήματα. Συνεχής υπηρεσία με ετήσια συνδρομή, SLA απόκρισης/αποκατάστασης, GDPR, δικαιώματα ελέγχου ΤτΕ, ρήτρες BRRD.",

  "type": "object",
  "additionalProperties": false,
  "required": ["category", "contract", "bank", "vendor", "solution", "term", "acceptance", "commercials", "penalties", "data_protection", "annexes"],

  "properties": {

    "category": { "const": "B_IT_SOLUTION" },

    "contract": { "$ref": "common.schema.json#/$defs/ContractHeader" },
    "bank":     { "$ref": "common.schema.json#/$defs/Bank" },
    "vendor":   { "$ref": "common.schema.json#/$defs/Vendor" },

    "solution": {
      "type": "object",
      "description": "Άρθρο 1 — Αντικείμενο.",
      "additionalProperties": false,
      "required": ["name", "business_purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "description": "Ονομασία Λύσης (εφεξής «η Λύση»)." },
        "business_purpose": {
          "type": "string",
          "minLength": 5,
          "description": "Επιχειρησιακός σκοπός. ΕΛΕΥΘΕΡΟ ΚΕΙΜΕΝΟ (Ζώνη 4). Π.χ. «κάλυψη των αναγκών των τηλεφωνικών κέντρων της Τράπεζας»."
        },
        "delivery_model": { "type": "string", "enum": ["SAAS", "MANAGED_SERVICE", "HYBRID"], "default": "SAAS" },
        "software_manufacturer": { "type": "string", "description": "Κατασκευαστής, αν διαφέρει από τον Ανάδοχο." },
        "included_services": {
          "type": "array",
          "items": { "type": "string", "enum": ["IMPLEMENTATION", "CONFIGURATION", "INSTALLATION", "TRAINING", "SUPPORT", "MIGRATION"] },
          "default": ["IMPLEMENTATION", "CONFIGURATION", "INSTALLATION", "TRAINING", "SUPPORT"]
        }
      }
    },

    "term": {
      "type": "object",
      "description": "Άρθρο 2 — Διάρκεια.",
      "additionalProperties": false,
      "required": ["start_date", "subscription_years", "subscription_start_basis"],
      "properties": {
        "start_date":         { "$ref": "common.schema.json#/$defs/Date" },
        "end_date":           { "$ref": "common.schema.json#/$defs/Date" },
        "subscription_years": { "type": "integer", "minimum": 1, "description": "Περίοδος χρήσης της Λύσης σε έτη." },
        "subscription_start_basis": {
          "type": "string",
          "enum": ["GO_LIVE", "HEAD_START_DATE", "EARLIER_OF_BOTH"],
          "description": "Βάση έναρξης της περιόδου χρήσης. Επηρεάζει Άρθρα 2 και 4."
        },
        "head_start_lag_months": {
          "type": "integer",
          "description": "Μήνες από την παράδοση αδειών έως το head start date (ορίζεται από τον κατασκευαστή)."
        },
        "is_retroactive":           { "type": "boolean", "description": "Κανόνας R-13 — παράγεται." },
        "extendable_by_agreement":  { "type": "boolean", "default": true }
      },
      "if":   { "properties": { "subscription_start_basis": { "enum": ["HEAD_START_DATE", "EARLIER_OF_BOTH"] } } },
      "then": { "required": ["start_date", "subscription_years", "subscription_start_basis", "head_start_lag_months"] }
    },

    "acceptance": {
      "type": "object",
      "description": "Άρθρο 3 — Διαδικασία & Τρόπος Παροχής.",
      "additionalProperties": false,
      "properties": {
        "window_working_days": { "type": "integer", "default": 30, "description": "Εργάσιμες ημέρες από ένταξη σε παραγωγική λειτουργία." },
        "deemed_accepted_on_expiry": { "type": "boolean", "const": true },
        "vendor_must_install_updates": { "type": "boolean", "const": true }
      }
    },

    "commercials": {
      "type": "object",
      "description": "Άρθρο 4 — Αμοιβή.",
      "additionalProperties": false,
      "required": ["total_price", "payment_terms_days", "tranches"],
      "properties": {
        "total_price":        { "$ref": "common.schema.json#/$defs/Money" },
        "payment_terms_days": { "type": "integer", "default": 45, "description": "Κανόνας R-09: 45 ημέρες για Κατηγορία B. Εκκρεμεί Q-07 (ασυνέπεια με A/C=60)." },
        "annual_subscription_fee": { "$ref": "common.schema.json#/$defs/Money" },
        "tranches": {
          "type": "array",
          "minItems": 1,
          "description": "Δόσεις πληρωμής. Κάθε δόση δένεται με γεγονός ενεργοποίησης.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "trigger"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["ANNUAL_SUBSCRIPTION", "PROFESSIONAL_SERVICES", "HARDWARE", "LEGACY_SUPPORT", "OTHER"]
              },
              "description": { "type": "string" },
              "percentage":  { "$ref": "common.schema.json#/$defs/Percentage" },
              "amount":      { "$ref": "common.schema.json#/$defs/Money" },
              "trigger": {
                "type": "string",
                "enum": ["SOW_ACCEPTANCE", "UAT_COMPLETION", "SIGN_OFF_GO_LIVE", "DELIVERY_CONFIRMED", "RENEWAL_ANNIVERSARY", "PERIOD_START", "OTHER"]
              }
            }
          }
        },
        "hardware": {
          "type": "object",
          "description": "Κανόνας R-08 — παράγραφος προμήθειας εξοπλισμού.",
          "additionalProperties": false,
          "required": ["included"],
          "properties": {
            "included":    { "type": "boolean", "default": false },
            "description": { "type": "string" },
            "amount":      { "$ref": "common.schema.json#/$defs/Money" }
          },
          "if":   { "properties": { "included": { "const": true } } },
          "then": { "required": ["included", "description", "amount"] }
        },
        "price_fixed": { "type": "boolean", "const": true, "description": "Παραίτηση από ΑΚ 388." }
      }
    },

    "transition": {
      "type": "object",
      "description": "Κανόνας R-07 — μεταβατική υποστήριξη υφιστάμενης (on-premise) εγκατάστασης.",
      "additionalProperties": false,
      "required": ["legacy_support"],
      "properties": {
        "legacy_support":   { "type": "boolean", "default": false },
        "legacy_system_name": { "type": "string" },
        "period_from":      { "$ref": "common.schema.json#/$defs/Date" },
        "period_to":        { "$ref": "common.schema.json#/$defs/Date" },
        "amount":           { "$ref": "common.schema.json#/$defs/Money" }
      },
      "if":   { "properties": { "legacy_support": { "const": true } } },
      "then": { "required": ["legacy_support", "legacy_system_name", "period_from", "period_to"] }
    },

    "penalties": {
      "type": "object",
      "description": "Άρθρο 3 — Ποινικές Ρήτρες. Κανόνας R-14: αν has_penalties=false, το block παραλείπεται ΚΑΙ ο τίτλος του άρθρου γίνεται «ΔΙΑΔΙΚΑΣΙΑ ΚΑΙ ΤΡΟΠΟΣ ΠΑΡΟΧΗΣ ΤΩΝ ΥΠΗΡΕΣΙΩΝ» (χωρίς το «- ΠΟΙΝΙΚΕΣ ΡΗΤΡΕΣ»).",
      "additionalProperties": false,
      "required": ["has_penalties"],
      "properties": {
        "has_penalties": { "type": "boolean", "default": true },
        "delay_per_day": { "$ref": "common.schema.json#/$defs/Money", "description": "Ποινική ρήτρα ανά ημέρα καθυστέρησης υλοποίησης." },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "has_sla":     { "type": "boolean", "default": true },
            "target_pct":  { "$ref": "common.schema.json#/$defs/Percentage" },
            "reference_annex_section": { "type": "string" }
          }
        },
        "sla_rates": {
          "type": "array",
          "description": "Ρήτρες ανά σοβαρότητα × μετρική (Response time / Restoration target).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "metric", "pct", "unit"],
            "properties": {
              "severity": { "type": "string", "enum": ["CRITICAL_PRODUCTION_DOWN", "CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "metric":   { "type": "string", "enum": ["RESPONSE_TIME", "RESTORATION_TARGET"] },
              "pct":      { "$ref": "common.schema.json#/$defs/Percentage" },
              "unit":     { "type": "string", "enum": ["HOUR", "DAY"] },
              "base":     { "type": "string", "enum": ["QUARTERLY_SUPPORT_FEE", "MONTHLY_SERVICE_COST", "ANNUAL_FEE"], "default": "QUARTERLY_SUPPORT_FEE" }
            }
          }
        },
        "vulnerability": {
          "type": "object",
          "description": "P = V × N / 365.",
          "additionalProperties": false,
          "properties": {
            "applies":        { "type": "boolean", "default": true },
            "measures_annex": { "type": "integer", "default": 2 }
          }
        },
        "cap_pct_annual": {
          "$ref": "common.schema.json#/$defs/Percentage",
          "default": 50,
          "description": "Ανώτατο σύνολο ρητρών σε ετήσια βάση ως % της ετήσιας αξίας σύμβασης."
        },
        "settlement": { "type": "string", "enum": ["DIRECT_PAYMENT", "SET_OFF", "EITHER"], "default": "EITHER" }
      },
      "if":   { "properties": { "has_penalties": { "const": true } } },
      "then": { "required": ["has_penalties", "cap_pct_annual"] }
    },

    "guarantee": { "$ref": "common.schema.json#/$defs/LetterOfGuarantee" },

    "security": {
      "type": "object",
      "description": "Κανόνας R-12 — προαιρετικό άρθρο «ΠΡΟΤΥΠΑ ΑΣΦΑΛΕΙΑΣ ΠΛΗΡΟΦΟΡΙΩΝ». Εμφανίστηκε στο υπογεγραμμένο MOVEO αλλά ΔΕΝ υπάρχει στο σημερινό πρότυπο — προστίθεται ως προαιρετική ενότητα.",
      "additionalProperties": false,
      "properties": {
        "include_standards_article": { "type": "boolean", "default": false },
        "standards": {
          "type": "array",
          "items": { "type": "string", "enum": ["ISO_27001", "ISO_27017", "ISO_27018", "SOC2_TYPE_II", "PCI_DSS", "OTHER"] }
        },
        "measures_annex": { "type": "integer", "default": 2 }
      },
      "if":   { "properties": { "include_standards_article": { "const": true } } },
      "then": { "required": ["include_standards_article", "standards"] }
    },

    "subcontracting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_subcontractors": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Subcontractor" },
          "default": []
        }
      }
    },

    "data_protection": { "$ref": "common.schema.json#/$defs/DataProtection" },

    "audit": {
      "type": "object",
      "description": "Άρθρο 14 — Έλεγχος (δικαιώματα Τράπεζας & Τράπεζας της Ελλάδος).",
      "additionalProperties": false,
      "properties": {
        "frequency_per_year":     { "type": "integer", "default": 1 },
        "third_party_certifications_accepted": { "type": "boolean", "default": true }
      }
    },

    "termination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "convenience_notice_months": { "type": "integer", "default": 3 },
        "brrd_clauses_apply":        { "type": "boolean", "const": true },
        "transition_support_months": { "type": "integer", "default": 6 }
      }
    },

    "annexes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/Annex" },
      "description": "Τυπική σύνθεση Κατηγορίας B: 1 Περιγραφή Έργου/Τεχνική Πρόταση, 2 Μέτρα Ασφάλειας, 3 GDPR."
    },

    "_meta": { "$ref": "common.schema.json#/$defs/GenerationMeta" }
  }
}
