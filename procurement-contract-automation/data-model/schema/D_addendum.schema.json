{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nbg.gr/procurement/contracts/D_addendum.schema.json",
  "title": "Κατηγορία D — ADDENDUM (Πρόσθετη Πράξη)",
  "description": "Πρότυπο NBG_ADDENDUM_GR. Δεν είναι αυτοτελής σύμβαση αλλά ΔΙΑΦΟΡΙΚΟ έγγραφο: λίστα πράξεων τροποποίησης επί υφιστάμενης σύμβασης. Προτεινόμενος υποψήφιος για pilot αυτοματοποίησης.",

  "type": "object",
  "additionalProperties": false,
  "required": ["category", "addendum", "original_contract", "bank", "vendor", "amendments"],

  "properties": {

    "category": { "const": "D_ADDENDUM" },

    "addendum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "sequence", "signing_date"],
      "properties": {
        "number":       { "type": "string", "minLength": 1, "description": "ΑΡ. ΠΡΟΣΘΕΤΗΣ ΠΡΑΞΗΣ (π.χ. «3246Α»)." },
        "sequence":     { "type": "integer", "minimum": 1, "description": "Νο. 1, 2, 3… — η πολλοστή πρόσθετη πράξη επί της αρχικής σύμβασης." },
        "signing_date": { "$ref": "common.schema.json#/$defs/Date" },
        "signing_place":{ "type": "string", "default": "Αθήνα" },
        "cover_period": { "type": "string", "description": "π.χ. «ΙΑΝΟΥΑΡΙΟΣ 2026». ΠΑΡΑΓΕΤΑΙ από το signing_date." },
        "title": {
          "type": "string",
          "description": "Τίτλος εξωφύλλου, π.χ. «ΠΡΟΣΘΕΤΗ ΠΡΑΞΗ ΣΤΗ ΣΥΜΒΑΣΗ ΣΥΝΤΗΡΗΣΗΣ – ΥΠΟΣΤΗΡΙΞΗΣ ΠΡΟΪΟΝΤΩΝ ΛΟΓΙΣΜΙΚΟΥ …»"
        },
        "subtitle": { "type": "string", "description": "Προαιρετικός υπότιτλος σε παρένθεση, π.χ. «(AML and Financial Crime Compliance)»." }
      }
    },

    "original_contract": {
      "type": "object",
      "description": "Πηγή: μητρώο συμβάσεων (εκκρεμεί Q-15).",
      "additionalProperties": false,
      "required": ["number", "date", "subject"],
      "properties": {
        "number":  { "type": "string", "description": "ΑΡΧΙΚΗ ΣΥΜΒΑΣΗ (π.χ. «3246»)." },
        "date":    { "$ref": "common.schema.json#/$defs/Date" },
        "subject": {
          "type": "string",
          "minLength": 10,
          "description": "Αντικείμενο αρχικής σύμβασης, όπως αναφέρεται στο προοίμιο («…με αντικείμενο την παροχή υπηρεσιών συντήρησης-υποστήριξης …»)."
        },
        "previous_addenda": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "date"],
            "properties": {
              "number": { "type": "string" },
              "date":   { "$ref": "common.schema.json#/$defs/Date" }
            }
          },
          "description": "Προηγούμενες πρόσθετες πράξεις — αν sequence > 1 πρέπει να αναφέρονται."
        }
      }
    },

    "bank":   { "$ref": "common.schema.json#/$defs/Bank" },
    "vendor": { "$ref": "common.schema.json#/$defs/Vendor" },

    "renewal": {
      "type": "object",
      "description": "Το συνηθέστερο σενάριο: ανανέωση υπηρεσιών συντήρησης/υποστήριξης.",
      "additionalProperties": false,
      "required": ["is_renewal"],
      "properties": {
        "is_renewal":  { "type": "boolean" },
        "services_description": { "type": "string", "description": "π.χ. «υπηρεσίες τεχνικής υποστήριξης-συντήρησης»." },
        "period_from": { "$ref": "common.schema.json#/$defs/Date" },
        "period_to":   { "$ref": "common.schema.json#/$defs/Date" },
        "is_retroactive": {
          "type": "boolean",
          "description": "Κανόνας R-13. ΠΑΡΑΓΕΤΑΙ: period_from < addendum.signing_date → εισάγεται η λέξη «αναδρομικά»."
        },
        "extension_years": { "type": "integer", "minimum": 1 }
      },
      "if":   { "properties": { "is_renewal": { "const": true } } },
      "then": { "required": ["is_renewal", "services_description", "period_from", "period_to"] }
    },

    "amendments": {
      "type": "array",
      "minItems": 1,
      "description": "Οι πράξεις τροποποίησης, με τη σειρά που εμφανίζονται στο έγγραφο.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "target"],
        "properties": {

          "operation": {
            "type": "string",
            "enum": ["ADD_PARAGRAPH", "ADD_SUBCLAUSE", "MODIFY_CLAUSE", "REPLACE_ANNEX", "DELETE_CLAUSE"],
            "description": "ADD_PARAGRAPH = «Προσθέτουν νέα παράγραφο στο τέλος του Άρθρου X (ΤΙΤΛΟΣ)…» · ADD_SUBCLAUSE = «…προσθήκη νέου εδαφίου υπ. αριθμ. X.Y.Z στον όρο X.Y του Άρθρου X (ΤΙΤΛΟΣ)…» · MODIFY_CLAUSE = «…τροποποίηση του όρου X.Y στο Άρθρο X (ΤΙΤΛΟΣ)…» · REPLACE_ANNEX = «…αντικατάσταση του Παραρτήματος N από το νέο Παράρτημα N/ΕΤΟΣ…» · DELETE_CLAUSE = διαγραφή όρου."
          },

          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "article_no":    { "type": "integer", "minimum": 1 },
              "article_title": { "type": "string", "description": "Εμφανίζεται σε ΚΕΦΑΛΑΙΑ μέσα σε παρένθεση, π.χ. «(ΔΙΑΡΚΕΙΑ)»." },
              "clause_no":     { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$", "description": "π.χ. «5.1»." },
              "annex_no":      { "type": "integer", "minimum": 1 }
            }
          },

          "new_clause_no": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)*$",
            "description": "Μόνο για ADD_SUBCLAUSE — ο αριθμός του νέου εδαφίου (π.χ. «5.1.1»)."
          },

          "new_annex_label": {
            "type": "string",
            "description": "Μόνο για REPLACE_ANNEX — π.χ. «Παράρτημα 1/2025»."
          },

          "new_text": {
            "type": "string",
            "description": "Το νέο κείμενο σε εισαγωγικά «…». ΕΛΕΥΘΕΡΟ ΚΕΙΜΕΝΟ (Ζώνη 4) — απαιτεί ανθρώπινο έλεγχο."
          },

          "price_table": {
            "type": "object",
            "description": "Προαιρετικός πίνακας τιμών που ενσωματώνεται στο νέο κείμενο. ΚΡΙΣΙΜΟ: στο υπογεγραμμένο δείγμα UNISYSTEMS 8 κελιά έμειναν ως «€ΧΧΧ». Κανόνας R-18 — κάθε κελί είναι υποχρεωτικό.",
            "additionalProperties": false,
            "required": ["columns", "rows", "total"],
            "properties": {
              "caption": { "type": "string", "default": "Πίνακας Τιμών" },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" },
                "description": "Επικεφαλίδες στηλών ποσών, π.χ. [\"2025\", \"2026\"]."
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["description", "amounts"],
                  "properties": {
                    "description": { "type": "string", "minLength": 3 },
                    "amounts": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "$ref": "common.schema.json#/$defs/Money" },
                      "description": "Ένα ποσό ανά στήλη. Το μήκος ΠΡΕΠΕΙ να ισούται με το μήκος του columns."
                    },
                    "is_subtotal": { "type": "boolean", "default": false }
                  }
                }
              },
              "total": {
                "$ref": "common.schema.json#/$defs/Money",
                "description": "Συνολικό ποσό. ΕΛΕΓΧΟΣ: πρέπει να ισούται με το άθροισμα των rows (πλην subtotals)."
              }
            }
          }
        },

        "allOf": [
          {
            "if":   { "properties": { "operation": { "const": "ADD_SUBCLAUSE" } }, "required": ["operation"] },
            "then": { "required": ["operation", "target", "new_clause_no", "new_text"] }
          },
          {
            "if":   { "properties": { "operation": { "enum": ["ADD_PARAGRAPH", "MODIFY_CLAUSE"] } }, "required": ["operation"] },
            "then": { "required": ["operation", "target", "new_text"] }
          },
          {
            "if":   { "properties": { "operation": { "const": "REPLACE_ANNEX" } }, "required": ["operation"] },
            "then": { "required": ["operation", "target", "new_annex_label"] }
          }
        ]
      }
    },

    "attached_annexes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Annex" },
      "description": "Παραρτήματα που επισυνάπτονται στην Πρόσθετη Πράξη και αποτελούν αναπόσπαστο μέρος της Σύμβασης."
    },

    "survival_clause": {
      "type": "boolean",
      "const": true,
      "description": "«Κατά τα λοιπά οι όροι της Σύμβασης εξακολουθούν να ισχύουν ως έχουν…» — πάντοτε παρούσα."
    },

    "_meta": { "$ref": "common.schema.json#/$defs/GenerationMeta" }
  }
}
